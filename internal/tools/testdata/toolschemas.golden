[[{"about":{"description":"what the command does in 5-10 words, shown to the user, e.g. Run the unit tests.","type":"string"},"command":{"type":"string"},"timeout_ms":{"description":"default 60000, max 600000; raise it for slow builds and test suites","type":"integer"}},["command"],false],[{"limit":{"description":"how many lines to read; omit for the whole file, still at most 2000 lines or 50000 bytes","type":"integer"},"offset":{"description":"1-based line to start at","type":"integer"},"path":{"description":"relative to the working directory, or absolute","type":"string"}},["path"],true],[{"content":{"type":"string"},"path":{"type":"string"}},["path","content"],false],[{"new_string":{"type":"string"},"old_string":{"type":"string"},"path":{"type":"string"},"replace_all":{"type":"boolean"}},["path","old_string","new_string"],false],[{"path":{"description":"directory to search under; default the working directory","type":"string"},"pattern":{"description":"glob such as *.go, src/**/*.ts or *.{ts,tsx}","type":"string"}},["pattern"],true],[{"include":{"description":"glob limiting which files are searched, such as *.go","type":"string"},"path":{"description":"file or directory to search; default the working directory","type":"string"},"pattern":{"description":"RE2 regular expression matched against each line","type":"string"}},["pattern"],true],[{"url":{"type":"string"}},["url"],true],[{"todos":{"items":{"properties":{"active_form":{"description":"on the in_progress item only: present tense shown while it runs, e.g. Running tests","type":"string"},"content":{"type":"string"},"status":{"enum":["pending","in_progress","done"],"type":"string"}},"required":["content","status"],"type":"object"},"type":"array"}},[],false],[{"questions":{"items":{"properties":{"description":{"description":"markdown shown under the question","type":"string"},"header":{"description":"a 1-3 word label, e.g. Auth method","type":"string"},"options":{"description":"required for single_choice and multi_choice","items":{"properties":{"description":{"type":"string"},"label":{"type":"string"}},"required":["label"],"type":"object"},"type":"array"},"question":{"description":"the complete question, ending with a question mark","type":"string"},"type":{"description":"multi_choice lets the user mark several; free_text is typed; defaults to single_choice with options, free_text without","enum":["single_choice","multi_choice","free_text"],"type":"string"}},"required":["question"],"type":"object"},"type":"array"}},["questions"],false],[{"plan":{"description":"the plan in markdown","type":"string"}},["plan"],false],[{"about":{"description":"what the process is in 3-6 words, shown to the user, e.g. Dev server.","type":"string"},"command":{"type":"string"}},["command"],true],[{"id":{"type":"string"},"wait_ms":{"description":"wait until the job exits, or goes quiet for 2s after printing, at most this long (max 600000, default 0)","type":"integer"}},["id"],true],[{},[],true],[{"id":{"type":"string"}},["id"],false],[{"content":{"description":"file mode: the file's full content, 32 KiB at most","type":"string"},"description":{"description":"promote mode: the catalog line's description (required, one line)","type":"string"},"path":{"description":"file mode: a freeform .md in the private brain (a bare file name lands there); promote mode: the .md file name in the promoted line's brain dir","type":"string"},"promote":{"description":"promote mode: the memory id to move into a brain file","type":"string"},"query":{"description":"search mode: words to match against memory text or id, both scopes, live and ledger; the other fields are ignored","type":"string"},"quote":{"description":"the user's exact words from this session that this memory rests on","type":"string"},"read_if":{"description":"promote mode: when to read the file (required, one line)","type":"string"},"replaces":{"description":"the memory to rewrite, or to drop when text is empty: its id from the ## Memory section","type":"string"},"scope":{"description":"project (default): this repository only; user: holds in every project","enum":["project","user"],"type":"string"},"text":{"type":"string"}},[],false],[{"path":{"type":"string"}},["path"],true],[{"action":{"enum":["definition","implementation","references","rename","symbols","workspace_symbols","call_hierarchy"],"type":"string"},"direction":{"description":"call_hierarchy only; who calls the symbol or what it calls, omitted = both","enum":["incoming","outgoing"],"type":"string"},"line":{"description":"1-based line, when the name appears more than once","type":"integer"},"new_name":{"description":"rename only","type":"string"},"path":{"description":"a file where the symbol appears (a use is enough for definition); the file to outline for symbols; any file of the language for workspace_symbols","type":"string"},"symbol":{"description":"the identifier as written, or the query for workspace_symbols; not for symbols","type":"string"}},["action","path"],false],[{"name":{"type":"string"}},["name"],true]]