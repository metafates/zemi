#!/bin/sh
# zemi-lab: a throwaway zemi TUI against a fake model, in tmux or in a Rex
# block, plus commands to drive and read it. Every lab is name-scoped (tree,
# tmux server or Rex session, port), so testers run in parallel with -n NAME.
# See SKILL.md next to this file.
set -u

usage() {
	cat <<'U'
usage: zemi-lab [-n name] [-s main|peer] command [args]

  up [-x W -y H] [--theme T] [--asks] [--untrusted] [--rex]
                     build, throwaway tree, fake model, TUI, wait for boot.
                     --rex runs zemi in a Rex block: the terminal acts on the
                     sequences tmux swallows (OSC 7501, OSC 9, titles) and
                     reports them as events
  peer [-x W -y H] [NAME]
                     another zemi on the same tree and store: what windows on
                     one project see, for sync and presence work; a third
                     window takes a name (default peer). The store is shared,
                     the model traffic is not: the peer gets its own fake
                     model writing under req-NAME
  -s main|peer       which window the drive commands act on
  prompt TEXT        clear a leftover draft, type TEXT plus a per-call marker,
                     Enter, wait for that marker to reach the model and the
                     screen to settle; refuses while any overlay waits
  type TEXT          literal text into the composer, no Enter; returns once
                     the text shows in the composer; refuses under an overlay
  send KEYS...       key names as tmux spells them (Enter, Escape, C-c, DC)
  wait [PATTERN]     until the screen stops changing, and PATTERN shows;
                     `wait ask` waits for any overlay (ask, question, plan)
  ask y|n|t          answer a permission ask; refuses when none is up
  cap [-e] [FILE]    capture the whole pane (-e keeps colors)
  size W H           resize the window; a rex lab fails loudly when the
                     resize did not stick (a client owning the block keeps
                     its size - bake layouts into up -x W -y H)
  snap [FILE]        capture, mask the volatile spans, save (default
                     $TREE/snap/prev.txt; the raw capture is kept beside it)
  diff [A] [B]       diff two masked captures - a fresh one against A, or
                     A against B - and exit 1 when rows moved
  events [NAME...]   block events the terminal saw (rex lab): filter by
                     program_status_changed, desktop_notification, bell,
                     title_changed, child_exited; exit 1 on no match
  records            the OSC 7501 records the terminal holds (rex lab)
  title              the pane title
  last               the selected window's last request body
  db | logs | status | health [args...]
  attach             how to watch this lab
  down [--keep]      quit zemi, kill the sessions and server, delete the
                     tree; a plain down also re-tears a kept tree
  down --force       reap a lab whose zemi is already dead (no exit clear)
U
	exit 2
}

[ $# -ge 1 ] || usage
NAME=zt
SESSION=main
while [ $# -ge 2 ]; do
	case "$1" in
		-n) NAME=$2; shift 2 ;;
		-s) SESSION=$2; shift 2 ;;
		*) break ;;
	esac
done
[ $# -ge 1 ] || usage
CMD=$1; shift

DIR=$(cd "$(dirname "$0")" && pwd)
REPO=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null || true)
TREE=${ZEMI_LAB_TREE:-${TMPDIR:-/tmp}/zemi-lab-$NAME}
SERVER=zl-$NAME
ENVF=$TREE/.lab.env
BLOCKS=$TREE/.lab.blocks
export TMUX_TMPDIR="${TMPDIR:-/tmp}"

BACKEND=tmux
RSESSION="" RBLK=""

say() { printf '%s\n' "$*"; }
die() { printf 'zemi-lab: %s\n' "$*" >&2; exit 1; }

[ "$CMD" = up ] && [ "$SESSION" != main ] &&
	die "up takes no -s (a lab's first window is always 'main'; peers come from peer)"

# block_id NAME: the Rex block id a lab window maps to (from .lab.blocks,
# "name id" lines written at up/peer).
block_id() { awk -v n="$1" '$1 == n {print $2}' "$BLOCKS" 2>/dev/null; }

# req_base: the selected window's own model traffic. Every window boots its
# own fake writing under its own dir, so a pair typed into a peer can only
# land in the peer's stream - the direct route is closed. The store is still
# shared: every window's DELIVERED words ride each later request's <chat>
# fold in every window, so the match reads only requests past the prompt's
# baseline and the per-tree lock (no window delivers while a prompt polls)
# plus the per-prompt marker hold the fold route
req_base() {
	[ "$SESSION" = main ] && printf '%s' "$TREE" || printf '%s/req-%s' "$TREE" "$SESSION"
}

# rex_sessions_by_label: every lab session is labeled zemi-lab-$NAME, so the
# up guard and down find a session even when the tree (and with it the env
# file that named it) is gone.
rex_sessions_by_label() {
	rex ls --json 2>/dev/null | python3 -c '
import json, sys
for s in json.load(sys.stdin).get("sessions", []):
    if s.get("label") == "zemi-lab-'"$NAME"'":
        print(s["session_id"])
'
}

# fgpid SESSION BLOCK: the block's foreground pid, empty when the block or
# its answer is gone - a dead block must read as "no pid", never a traceback.
fgpid() {
	rex block call -s "$1" -b "$2" process 2>/dev/null |
		python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    raise SystemExit
print((d.get("foreground") or {}).get("pid", ""))
'
}

load() {
	[ -f "$ENVF" ] || die "no lab '$NAME' at $TREE (zemi-lab up first)"
	# shellcheck disable=SC1090
	. "$ENVF"
	BACKEND=${LAB_BACKEND:-tmux}
	case "$SESSION" in
		fake | recorder) die "'$SESSION' is lab plumbing, not a window (-s main|peer)" ;;
	esac
	# shellcheck disable=SC2153  # LAB_SESSION comes from the sourced env file, not this script
	if [ "$BACKEND" = rex ]; then
		RSESSION=${LAB_RSESSION:-}
		RBLK=$(block_id "$SESSION")
		[ -n "$RBLK" ] || die "no window '$SESSION' (zemi-lab peer first)"
		rex block ls -s "$RSESSION" --json >/dev/null 2>&1 ||
			die "the Rex session is gone (zemi-lab up first)"
		# a block outlives its process: after a wedged-zemi kill every drive
		# command would serve the corpse's last screen, so check the block's
		# foreground pid with the kernel before serving anything
		fgp=$(fgpid "$RSESSION" "$RBLK")
		# shellcheck disable=SC2015  # either an empty pid or a dead one dies here
		[ -n "$fgp" ] && kill -0 "$fgp" 2>/dev/null ||
			die "the '$SESSION' block has no live process (zemi died? zemi-lab down and up again)"
	elif [ "$SESSION" != "$LAB_SESSION" ]; then
		tmux -L "$SERVER" has-session -t "$SESSION" 2>/dev/null ||
			die "no window '$SESSION' (zemi-lab peer first)"
	fi
}

cap() {
	case $BACKEND in
		rex) rex capture -s "$RSESSION" -b "$RBLK" 2>/dev/null || true ;;
		*) tmux -L "$SERVER" capture-pane -t "$SESSION" -p 2>/dev/null || true ;;
	esac
}

# composer_has TEXT: whether the composer box's rows carry TEXT. The box is
# read as the bottom-most block of box rows, never the whole screen: a
# transcript row echoing the same words must not pass for the composer. The
# box is a scrolling viewport - a long text shows only its tail - and a
# narrow pane folds rows, so the match is on the joined, unspaced rows: the
# whole text when it fits, else its last 40 characters at the content's end.
composer_has() {
	cap | python3 -c '
import sys
text = sys.argv[1].replace(" ", "").replace("\t", "")
run = []
for l in reversed(sys.stdin.read().splitlines()):
    s = l.strip()
    if s.startswith("│"):
        run.append(l)
    elif run:
        break
joined = "".join(r.replace("│", "").replace(" ", "").replace("\t", "") for r in reversed(run))
ok = text in joined or (len(text) > 40 and joined.endswith(text[-40:]))
sys.exit(0 if ok else 1)
' "$1"
}

# request_carries MSG AT: whether a request newer than AT (the prompt's
# baseline count) carries MSG - a prompt's full text and its [zl:PID] marker
# matched together. The marker alone proves nothing: it is the caller's pid,
# readable off the composer and typeable by any window, so only a delivery
# of this very text (a verbatim user message, or inside a later <chat> fold
# or compaction block, both built from delivered messages) can put the pair
# in a request, and pre-baseline requests cannot vouch for this prompt at
# all. An erased draft (an interrupt restores it to the composer) leaves no
# trace, and no older turn can impersonate it the way a duplicate text could
# a content match.
request_carries() {
	python3 -c '
import glob, json, os, sys
tree = os.path.dirname(sys.argv[1])
needle = sys.argv[2]
at = int(sys.argv[3]) if len(sys.argv) > 3 else 0
def texts(m):
    c = m.get("content")
    if isinstance(c, list):
        return [p.get("text", "") for p in c if isinstance(p, dict)]
    return [c] if isinstance(c, str) else []
for f in sorted(glob.glob(os.path.join(tree, "requests", "[0-9]*.json"))):
    try:
        if int(os.path.basename(f).split(".")[0]) <= at:
            continue
        d = json.load(open(f))
    except (ValueError, OSError):
        continue
    for m in d.get("messages", []):
        if m.get("role") == "user":
            for t in texts(m):
                if needle in t:
                    sys.exit(0)
sys.exit(1)
' "$(req_base)/last_request.json" "$1"
}

# overlay_kind: what overlay waits on the user right now, read from terminal
# state - never from screen text, which transcript rows echo. A rex lab
# reads the OSC 7501 blocked record (permission, question); tmux swallows
# those sequences, so its title mark (? while any prompt waits) stands in.
overlay_kind() {
	if [ "$BACKEND" = rex ]; then
		rex block call -s "$RSESSION" -b "$RBLK" program_status 2>/dev/null |
			python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    raise SystemExit
for r in d.get("records", []):
    if r.get("state") == "blocked":
        print(r.get("kind") or "blocked")
        break
'
		return 0
	fi
	case "$(tmux -L "$SERVER" display -p -t "$SESSION" '#{pane_title}' 2>/dev/null)" in
		"? "*) printf 'prompt' ;;
	esac
}

# wait_ask [secs]: until any overlay waits on the user - terminal state on
# both backends (rex: the blocked record; tmux: the ? title mark), never
# screen text, which a narrow pane folds and transcript rows echo.
wait_ask() {
	SECS=${1:-30} i=0
	while [ "$i" -lt $((SECS * 4)) ]; do
		[ -n "$(overlay_kind)" ] && return 0
		i=$((i + 1))
		sleep 0.25
	done
	return 1
}

# key_rex: tmux key spelling (C-c, Escape, BTab, DC) into Rex's (ctrl+c,
# escape, shift+tab, delete); unknown names pass through and rex rejects
# them loudly.
key_rex() {
	case "$1" in
		C-*) printf 'ctrl+%s' "${1#C-}" ;;
		M-*) printf 'alt+%s' "${1#M-}" ;;
		Escape | Enter | Space | Tab | Backspace | Up | Down | Left | Right | Home | End | PageUp | PageDown | Insert)
			printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
			;;
		Del | DC) printf 'delete' ;; # tmux spells delete DC; rex rejects del
		BSpace) printf 'backspace' ;;
		BTab) printf 'shift+tab' ;;
		*) printf '%s' "$1" ;;
	esac
}

send_keys() {
	case $BACKEND in
		rex)
			for k do
				rex send-key -s "$RSESSION" -b "$RBLK" -- "$(key_rex "$k")" ||
					die "send: rex refused key '$k'"
			done
			;;
		*) tmux -L "$SERVER" send-keys -t "$SESSION" "$@" ;;
	esac
}

type_text() {
	case $BACKEND in
		rex) rex send -s "$RSESSION" -b "$RBLK" -- "$*" || die "rex send failed" ;;
		*) tmux -L "$SERVER" send-keys -t "$SESSION" -l -- "$*" ;;
	esac
}

# mask_volatile blanks the spans that move on their own - the readout's
# elapsed seconds, tokens and cost, the braille spinner, the clock, the
# snail's eyes - so a diff shows only real row shifts. Raw captures are kept
# beside the masked ones (snap saves both), so any diff is re-checkable
# unmasked.
# the regexes' $ and $@ are python's, not the shell's
# shellcheck disable=SC2016
mask_volatile() {
	python3 -c '
import re, sys
out = []
for line in sys.stdin.read().splitlines():
    # the spinner animates wherever it runs; the eyes decay in the border
    line = re.sub(r"[\u2800-\u28ff]+", "@", line)
    line = re.sub(r"(┌ )@[.·?><^]{2}", r"\1@··", line)
    # a turn telemetry ticks mid-screen: model · seconds · N out · clock,
    # wrapped rows once the model token scrolls off its line. The
    # transcript carries the same shape as the user typed it, so a ▌ row
    # keeps its figures
    if line.lstrip()[:1] != "▌":
        line = re.sub(r"· \d+(?:\.\d+)?s · \d+ out · \d{1,2}:\d{2}", "· @ · @ out · @", line)
        line = re.sub(r"\d+(?:\.\d+)?s · \d+ out · \d{1,2}:\d{2}", "@ · @ out · @", line)
    # the right rail thumb travels as rows scroll: read it as the empty
    # cell it lands on, so a box border keeps its column (a masked border
    # reads as a rail cell and eats a trailing duration with it)
    line = re.sub(r"[█▌]$", "│", line)
    # a working border ticks its elapsed clock and retry countdown; it is
    # ui chrome, so every figure on it is volatile
    if line.lstrip()[:1] in ("┌", "└"):
        line = re.sub(r"\b\d+m \d+s\b", "@ @", line)
        line = re.sub(r"\b\d+(?:\.\d+)?[smh]\b", "@", line)
    out.append(line)
# elapsed/cost/clock figures live in the statusline (the last non-empty
# line); the user words in the rows above keep theirs
for i in range(len(out) - 1, -1, -1):
    if out[i].strip():
        line = out[i]
        line = re.sub(r"\b\d+m\b", "@m", line)         # elapsed minutes
        line = re.sub(r"\d+\.\d+s", "@s", line)        # elapsed seconds
        line = re.sub(r"(?<=in )\d+[ms]\b", "@s", line)  # a retry countdown ticks
        line = re.sub(r"\d+ (out|tok)", r"@ \1", line)  # token counts
        line = re.sub(r"\$\d+(\.\d+)?", "$@", line)     # cost figures
        line = re.sub(r"\d{1,2}:\d{2}", "@", line)      # the clock
        out[i] = line
        break
for i, line in enumerate(out):
    # a running tool ticks its right-aligned duration every second, with a
    # rail cell or border riding behind it; the two spaces of its gap keep
    # a user row ending in its own `in 5m` (one space) intact
    line = re.sub(r"(\s{2,})\d+(?:\.\d+)?[smh]\s*[│@]?\s*$", r"\1@", line)
    out[i] = line
sys.stdout.write("\n".join(out) + "\n")
'
}

# wait_stable [pattern] [secs]: the app redraws nothing when idle, so three
# identical captures mean settled; with a pattern, 0 once the settled screen
# shows it - while the screen still moves, turn N's rows still carry turn
# N-1's reply, so a pattern alone proves nothing - 1 when the screen settled
# without it or never settled.
wait_stable() {
	PAT=${1:-} SECS=${2:-30}
	i=0 prev="" same=0
	while [ "$i" -lt $((SECS * 4)) ]; do
		cur=$(cap)
		if [ "$cur" = "$prev" ]; then same=$((same + 1)); else same=0; fi
		prev=$cur
		if [ "$same" -ge 3 ]; then
			if [ -z "$PAT" ] || printf '%s\n' "$cur" | grep -qF -- "$PAT"; then return 0; fi
			return 1
		fi
		i=$((i + 1))
		sleep 0.25
	done
	return 1
}

free_port() { python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()'; }

# wait_port: the fake model is ready when it listens, not when its block
# merely exists - a bind failure or a slow start reads the same way here.
wait_port() {
	p=${1:-$PORT}
	i=0
	while [ "$i" -lt 40 ]; do
		python3 -c "import socket; s = socket.socket(); s.settimeout(0.5); s.connect(('127.0.0.1', $p)); s.close()" 2>/dev/null && return 0
		i=$((i + 1))
		sleep 0.25
	done
	return 1
}

# write_config: the generated init.lua and the askgate plugin, shared by both
# backends.
# write_config [DIR] [PORT]: init.lua pointing at a fake model; a peer
# window passes its own dir and its own fake's port
write_config() {
	dir=${1:-$TREE/config} port=${2:-$PORT}
	{
		echo 'zemi.provider.add({ id = "fake", kind = "openai_compat",'
		echo "	api_key = \"x\", base_url = \"http://127.0.0.1:$port/v1\","
		echo '	models = { { id = "m", context_window = 128000, pricing = { input = 0.27, output = 1.1 } } } })'
		echo 'zemi.config.set("models.default", "fake/m")'
		[ -n "${THEME:-}" ] && echo "zemi.config.set(\"ui.theme\", \"$THEME\")"
	} >"$dir/init.lua"

	[ -n "${ASKS:-}" ] || return 0
		mkdir -p "$TREE/data/plugins/local/askgate/.zemi"
		{
			echo '{"version":"0.1.0","description":"force the ask overlay on every action","uses":["perm"]}'
		} >"$TREE/data/plugins/local/askgate/.zemi/plugin.json"
		{
			echo "-- force the ask overlay on every action"
			echo 'zemi.event.on("permission.request", function() return { decision = "ask" } end)'
		} >"$TREE/data/plugins/local/askgate/.zemi/init.lua"
}

# wait_boot: poll captures until the composer shows, or fail loudly.
wait_boot() {
	i=0
	while [ "$i" -lt 120 ]; do
		case "$(cap)" in *"Ask anything"*) return 0 ;; esac
		i=$((i + 1))
		sleep 0.25
	done
	cap | grep -v '^ *$' | tail -10 >&2
	die "zemi did not boot in 30s"
}

# trust_note: an untrusted boot stops at the trust overlay, which holds the
# keys - say so instead of a bare success the first prompt would die behind.
# Bounded poll: the overlay renders a beat after the composer does. Both
# backends see it as a permission ask (rex: the blocked record; tmux: the ?
# title mark), so ask y answers it on either.
trust_note() {
	i=0
	while [ "$i" -lt 12 ]; do
		case "$(cap)" in
			*"Trust this"*)
				say "  the trust overlay is up: 'zemi-lab ask y' answers it (or boot trusted, the default)"
				return
				;;
		esac
		i=$((i + 1))
		sleep 0.25
	done
}

cmd_up() {
	W=140 H=40 THEME="" ASKS="" TRUST=--trust
	BACKEND=tmux
	while [ $# -gt 0 ]; do
		case "$1" in
			-x | -y | --theme)
				[ $# -ge 2 ] || die "up: $1 needs a value"
				case "$1" in
					-x) W=$2 ;;
					-y) H=$2 ;;
					--theme) THEME=$2 ;;
				esac
				shift 2
				;;
			--asks) ASKS=1; shift ;;
			--untrusted) TRUST=""; shift ;;
			--rex) BACKEND=rex; shift ;;
			*) die "up: unknown flag $1" ;;
		esac
	done
	[ -n "$REPO" ] || die "not inside the zemi repository; set ZEMI_BIN"
	# a lab of this name still up: refusing (never silently rebooting or
	# switching backends behind a live session) is what keeps down able to
	# reap everything
	[ -n "$(rex_sessions_by_label)" ] &&
		die "lab '$NAME' already has a rex session up (zemi-lab down reboots all)"
	# the probe runs whatever this up's backend is: a tmux lab of this name
	# must refuse a rex up too, or two zemis share one tree and down reaps
	# the tree under the survivor
	tmux -L "$SERVER" has-session 2>/dev/null &&
		die "lab '$NAME' is already up (zemi-lab down reboots all)"
	# the failed probe still creates the tmux socket file; a rex up leaves
	# none behind (a tmux up's new-session needs it)
	[ "$BACKEND" = rex ] && rm -f "${TMPDIR:-/tmp}"/tmux-*/"$SERVER"

	BIN=${ZEMI_BIN:-$REPO/bin/zemi}
	if [ -z "${ZEMI_BIN:-}" ]; then
		say "building $BIN..."
		make -C "$REPO" build >/dev/null || die "make build failed"
	fi
	case $BIN in /*) ;; *) BIN=$(cd "$(dirname "$BIN")" && pwd)/$(basename "$BIN") ;; esac
	[ -x "$BIN" ] || die "no zemi binary at $BIN"

	mkdir -p "$TREE/config" "$TREE/data" "$TREE/state" "$TREE/cache" "$TREE/proj"
	# a kept tree reboots clean: the last incarnation's snapshots, requests
	# (old [zl:PID] markers stay searchable across a reboot and weaken the
	# marker's uniqueness) and bodies would poison diff, last and this
	# boot's first prompt, and a stale stale-stream or kept mark would
	# refuse a healthy teardown
	rm -rf "$TREE/snap" "$TREE/requests" "$TREE"/req-*
	rm -f "$TREE"/.lab.turn "$TREE"/.lab.turn-* "$TREE/last_request.json" "$TREE/.lab.stale-stream" "$TREE/.lab.kept"
	[ -d "$TREE/proj/.git" ] || (cd "$TREE/proj" && git init -q) || die "git init failed"
	echo hello >"$TREE/proj/a.txt"

	PORT=$(free_port) || die "python3 is needed"
	write_config

	if [ "$BACKEND" = rex ]; then
		command -v rex >/dev/null 2>&1 || die "rex is not on PATH (up without --rex for the tmux lab)"
		rm -f "$BLOCKS"

		RS=$(rex new "zemi-lab-$NAME" --json | python3 -c 'import json,sys;print(json.load(sys.stdin)["session_id"])') ||
			die "rex new failed"
		RSESSION=$RS
		# record the session now: a failed boot must still leave a lab that
		# up (again) or down can tear down
		cat >"$ENVF" <<EOF
LAB_NAME="$NAME"
LAB_TREE="$TREE"
LAB_BACKEND="rex"
LAB_RSESSION="$RS"
LAB_SESSION="main"
EOF
		# the events recorder is a block, so it survives this shell: its stream
		# is the assertion surface for everything the terminal saw. Its id is
		# recorded so events can check the stream is still alive.
		EV=$(rex run -s "$RS" --label recorder --keep-open --focus=false --json -- \
			sh -c "rex events -s '$RS' --json > '$TREE/events.jsonl' 2> '$TREE/events.err'" |
			python3 -c 'import json,sys;print(json.load(sys.stdin)["block_ids"][0])') ||
			die "the events recorder failed to start"
		FB=$(rex run -s "$RS" --label fake --keep-open --focus=false --json -- \
			python3 "$DIR/fake_openai.py" "$PORT" "$TREE" |
			python3 -c 'import json,sys;print(json.load(sys.stdin)["block_ids"][0])') ||
			die "the fake model block failed to start"
		wait_port || {
			rex capture -s "$RS" -b "$FB" 2>/dev/null | grep -v '^ *$' | tail -5 >&2
			die "the fake model died (port taken?)"
		}
		RB=$(rex run -s "$RS" -c "$TREE/proj" --label "$SESSION" --keep-open --focus=false --json -- \
			env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor ZEMI_BIN="$BIN" "$DIR/zemi-safe" "$TREE" $TRUST |
			python3 -c 'import json,sys;print(json.load(sys.stdin)["block_ids"][0])') ||
			die "the zemi block failed to start"
		rex block call -s "$RS" -b "$RB" resize "{\"columns\":$W,\"rows\":$H}" >/dev/null ||
			die "resize to $W x $H failed"
		check_size "$RS" "$RB" "$W" "$H"
		{
			printf 'main %s\n' "$RB"
			printf 'fake %s\n' "$FB"
			printf 'recorder %s\n' "$EV"
		} >"$BLOCKS"
		RBLK=$RB
		wait_boot
		trust_note

		cat >"$ENVF" <<EOF
LAB_NAME="$NAME"
LAB_TREE="$TREE"
LAB_BACKEND="rex"
LAB_RSESSION="$RS"
LAB_PORT="$PORT"
LAB_TRUST="$TRUST"
LAB_SESSION="main"
EOF
		say "lab $NAME up (rex): $TREE, fake model 127.0.0.1:$PORT, session $RS ($W x $H)"
		say "  zemi-lab events | records | title          what the terminal saw"
		say "  zemi-lab prompt 'call shell {\"command\":\"ls\",\"about\":\"list\"}'"
		say "  zemi-lab cap | wait PATTERN | send Escape | ask y | db | logs | last | down"
		return
	fi

	# the fake model runs as a tmux session, so it survives this command and
	# dies with the lab; CWD is the tree, so its files never land in a repo
	tmux -L "$SERVER" new-session -d -s fake -c "$TREE" \
		"python3 '$DIR/fake_openai.py' $PORT '$TREE'" || die "tmux new-session failed"
	wait_port || {
		tmux -L "$SERVER" capture-pane -t fake -p 2>/dev/null | grep -v '^ *$' | tail -5 >&2
		die "the fake model died (port taken?)"
	}

	# exec: the login shell wrapping the boot line must not keep the pane
	# pid (fish never exec-optimizes a single command)
	tmux -L "$SERVER" new-session -d -s "$SESSION" -x "$W" -y "$H" -c "$TREE/proj" \
		"exec env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor ZEMI_BIN='$BIN' '$DIR/zemi-safe' '$TREE' $TRUST" ||
		die "tmux new-session failed"
	wait_boot
	trust_note

	cat >"$ENVF" <<EOF
LAB_NAME="$NAME"
LAB_TREE="$TREE"
LAB_BACKEND="tmux"
LAB_SERVER="$SERVER"
LAB_SESSION="$SESSION"
LAB_PORT="$PORT"
LAB_TRUST="$TRUST"
EOF
	say "lab $NAME up: $TREE, fake model 127.0.0.1:$PORT, tmux server $SERVER ($W x $H)"
	say "  zemi-lab prompt 'call shell {\"command\":\"ls\",\"about\":\"list\"}'"
	say "  zemi-lab cap | wait PATTERN | send Escape | ask y | db | logs | last | down"
}

# one prompt at a time per tree: two concurrent prompts share one composer,
# each composer_has check passes on the glued draft and one Enter submits
# both texts as a single message nobody typed
prompt_lock() {
	i=0
	while [ "$i" -lt 150 ]; do
		if mkdir "$TREE/.lab.prompt" 2>/dev/null; then
			echo $$ >"$TREE/.lab.prompt/pid"
			# a releaser's delayed rm can land after this mkdir: hold the lock
			# only if it is still ours. NOTE: the release's check-then-rm and
			# this check leave a microsecond window a stealer can still win -
			# the shell has no atomic check-and-delete; the retry is the recovery
			if [ "$(cat "$TREE/.lab.prompt/pid" 2>/dev/null)" = "$$" ]; then
				trap release_prompt_lock EXIT
				return 0
			fi
			rm -rf "$TREE/.lab.prompt"
		elif pid=$(cat "$TREE/.lab.prompt/pid" 2>/dev/null) && [ -n "$pid" ] &&
			! kill -0 "$pid" 2>/dev/null; then
			rm -rf "$TREE/.lab.prompt"
		fi
		sleep 0.2
		i=$((i + 1))
	done
	die "another prompt/type/send holds this lab (waited 30s; a stale lock: rm -rf $TREE/.lab.prompt)"
}

# release_prompt_lock: remove only what we still own - a stealer may have
# replaced the lock after our pid died
release_prompt_lock() {
	[ "$(cat "$TREE/.lab.prompt/pid" 2>/dev/null)" = "$$" ] && rm -rf "$TREE/.lab.prompt"
	return 0
}

# stopped: whether the selected window's zemi is SIGSTOP'd - a frozen screen
# reads as settled to a compare, so wait must refuse one (the boot line execs
# down to zemi, so the pane/block pid is zemi's own)
stopped() {
	case $BACKEND in
		rex) pid=$(fgpid "$RSESSION" "$RBLK") ;;
		*) pid=$(tmux -L "$SERVER" display -p -t "$SESSION" '#{pane_pid}' 2>/dev/null) ;;
	esac
	[ -n "$pid" ] || return 1
	# macOS appends flags to the state letter (Ts+ )
	case "$(ps -o state= -p "$pid" 2>/dev/null)" in T*) return 0 ;; esac
	return 1
}

# dead: whether the selected window's zemi is gone - a missing pane or block
# polls a screen that can never change, so wait would settle on a corpse
dead() {
	case $BACKEND in
	rex) [ -n "$(fgpid "$RSESSION" "$RBLK")" ] && return 1 ;;
	*) tmux -L "$SERVER" has-session -t "$SESSION" 2>/dev/null && return 1 ;;
	esac
	return 0
}

# fake_dead: whether the selected window's fake model stopped - a dead model
# burns the whole poll window on connection errors the window shows as its
# own rows, so the die names it instead of a queue
fake_dead() {
	if [ "$SESSION" = main ]; then b=fake; else b="fake-$SESSION"; fi
	case $BACKEND in
		rex) [ -z "$(fgpid "$RSESSION" "$(block_id "$b")")" ] ;;
		*) ! tmux -L "$SERVER" has-session -t "$b" 2>/dev/null ;;
	esac
}

cmd_prompt() {
	[ $# -ge 1 ] || die "prompt: text"
	stopped &&
		die "prompt: zemi is stopped (kill -CONT the pid first - a frozen screen reads as settled)"
	prompt_lock
	req=$(req_base)
	kind=$(overlay_kind)
	case "$kind" in
		permission) die "a permission ask is up (the prompt's keys would answer it - ask y|n first)" ;;
		"") ;;
		# tmux's mark cannot tell the kinds apart: advice must not name a key
		# that would answer the wrong overlay
		prompt) die "an overlay is up (tmux cannot name it; 'cap' shows which) - the prompt's keys would land in it: ask y|n answers a permission ask, send Escape dismisses the rest" ;;
		*) die "a $kind overlay is up (the prompt's keys would land in it - send Escape first)" ;;
	esac
	fake_dead &&
		die "this window's model is dead (its fake stopped answering - zemi-lab logs have the connection errors; down/up reboots it)"
	# the request count before Enter: last refuses to serve a body older than
	# the last prompt, so a turn that died before the model cannot silently
	# serve the previous body to a prompt-cache diff (per window: a peer's
	# prompt must not move this window's freshness mark)
	find "$req/requests" -type f 2>/dev/null | wc -l >"$TREE/.lab.turn-$SESSION"
	# a leftover draft glues onto the text; one C-c clears it (a second, on an
	# empty composer, quits) - but the C-c can be eaten by an overlay still
	# closing (send Escape; prompt right after), so verify the composer box
	# emptied and retry, bounded
	i=0
	while [ "$i" -lt 4 ]; do
		composer_has "Ask anything" && break
		send_keys C-c
		sleep 0.4
		i=$((i + 1))
	done
	composer_has "Ask anything" ||
		die "the composer will not empty (a draft survived 4 ctrl+c - an overlay may still be open)"
	# a per-call marker rides the text, so delivery is attributable to it
	# alone (request_carries); the composer check must match what was typed
	msg="$* [zl:$$]"
	type_text "$msg"
	# the text must sit in the composer before Enter: with an overlay up the
	# keys go to the overlay and the composer silently keeps its draft
	i=0
	while [ "$i" -lt 8 ]; do
		composer_has "$msg" && break
		i=$((i + 1))
		sleep 0.25
	done
	[ "$i" -lt 8 ] || die "the text never reached the composer (an overlay is open? zemi stopped? send Escape first)"
	send_keys Enter
	# the request counter is the source of truth that the turn started: the
	# screen cannot prove it - a stopped zemi holds the previous turn's rows
	# and every whole-screen grep matches them
	at=$(cat "$TREE/.lab.turn-$SESSION")
	i=0
	while [ "$i" -lt 40 ]; do
		# the request must carry this text: the count alone fires on any
		# request landing after the baseline - a queued steer's turn-start,
		# work predating the prompt - while this text sits undelivered
		if [ "$(find "$req/requests" -type f 2>/dev/null | wc -l)" -gt "$at" ] &&
			request_carries "$msg" "$at"; then
			break
		fi
		i=$((i + 1))
		sleep 0.25
	done
	[ "$i" -lt 40 ] || {
		# an overlay that rose over the prompt names itself; with none up the
		# cause is not knowable from here - zemi-lab logs tell them apart
		kind=$(overlay_kind)
		case "$kind" in
			permission) die "the prompt was delivered but a permission ask rose over it - the turn starts once it is answered (ask y, then wait again)" ;;
			prompt) die "the prompt was delivered but an overlay rose over it (tmux cannot name it; 'cap' shows which) - settle it (ask y|n or send Escape), then wait again" ;;
			"")
				if [ "$(find "$req/requests" -type f 2>/dev/null | wc -l)" -gt "$at" ]; then
					die "a turn ran but this prompt's marker never reached the model - the draft was eaten, or an interrupt restored it to the composer (a fresh prompt resubmits; zemi-lab logs)"
				fi
				if fake_dead; then
					die "no request arrived: this window's model is dead (its fake stopped answering; zemi-lab logs have the connection errors)"
				fi
				die "no request arrived within 10s (queued behind a running turn? zemi-lab logs)"
				;;
			*) die "the prompt was delivered but a $kind overlay rose over it - the turn starts once it is dismissed (send Escape, then wait again)" ;;
		esac
	}
	# the delivery above is the contract; a turn outlasting the settle
	# window is a delivered prompt whose working border still ticks
	wait_stable "" 30 ||
		say "the screen never settled within 30s (a turn is still running - 'wait PATTERN' waits it out)"
}

cmd_type() {
	[ $# -ge 1 ] || die "type: text"
	prompt_lock
	kind=$(overlay_kind)
	case "$kind" in
		permission) die "type: a permission ask is up (ask y|n first)" ;;
		"") ;;
		prompt) die "type: an overlay is up (tmux cannot name it; 'cap' shows which): ask y|n answers a permission ask, send Escape dismisses the rest" ;;
		*) die "type: a $kind overlay is up (the text would land in it - send Escape first)" ;;
	esac
	# an empty composer shows the placeholder, so typing exactly it could
	# not be told apart from an untouched composer - the verify would be
	# vacuous. The verify compares space-and-tab-stripped text, so any
	# spacing of the placeholder is as unverifiable as the exact one
	[ "$(printf '%s' "$*" | tr -d ' \t')" = "Askanything" ] &&
		die "type: 'Ask anything' is what an empty composer already shows - type other text (the verify could not tell them apart)"
	type_text "$@"
	# tmux delivers the burst late: an immediate capture false-negatives, so
	# return only once the text shows in the composer box (wrap-joined)
	i=0
	while [ "$i" -lt 8 ]; do
		composer_has "$*" && exit 0
		i=$((i + 1))
		sleep 0.25
	done
	die "type: '$*' never reached the composer (the pane died?)"
}

cmd_send() {
	[ $# -ge 1 ] || die "send: key names"
	prompt_lock
	send_keys "$@"
}

cmd_wait() {
	stopped &&
		die "wait: zemi is stopped (kill -CONT the pid first - a frozen screen reads as settled)"
	dead &&
		die "wait: this window's zemi is gone (the pane is dead - zemi-lab logs have why; up reboots the lab)"
	case "${1:-}" in
		ask)
			wait_ask && exit 0
			die "wait: no overlay appeared within 30s"
			;;
		*) PAT=${1:-} ;;
	esac
	wait_stable "$PAT" 30 && exit 0
	[ -n "$PAT" ] && die "wait: '$PAT' never showed (the screen settled without it)"
	die "wait: the screen kept changing for 30s"
}

cmd_ask() {
	case "${1:-}" in y | n | t) ;; *) die "ask: y, n or t" ;; esac
	# there must be a permission ask to answer: with none up, "overlay gone"
	# is trivially true and the command would lie. The rex lab reads the
	# terminal's blocked record (kind=permission); tmux's ? title mark cannot
	# tell the overlay kinds apart, so it answers whatever holds the mark.
	if [ "$BACKEND" = rex ]; then
		kind=$(overlay_kind)
		case "$kind" in
			permission) ;;
			"") die "no permission ask is up (wait ask first - the ask may have been answered already)" ;;
			# y and n do not answer these: a plan ask's keys type into its
			# changes box, a question's start an answer - Escape dismisses both
			question | blocked) die "a $kind ask is up (y|n do not answer it - send Escape dismisses it)" ;;
			*) die "a $kind ask is up (ask answers y|n - send Escape dismisses it)" ;;
		esac
	else
		wait_ask 5 ||
			die "no overlay is up (wait ask first - the ask may have been answered already)"
	fi
	# the first key can land in the grace; resend until the overlay is gone
	i=0
	while [ "$i" -lt 10 ]; do
		if [ "$BACKEND" = rex ]; then
			[ "$(overlay_kind)" != permission ] && exit 0
		elif [ -z "$(overlay_kind)" ]; then
			exit 0
		fi
		send_keys "$1"; sleep 0.5
		i=$((i + 1))
	done
	[ "$i" -lt 10 ] || {
		if [ "$BACKEND" = rex ]; then
			die "the ask is still up after 10 tries"
		fi
		# tmux's mark cannot tell the kinds apart, so the y's may have keyed
		# into a plan's changes box or a question's answer - name the escape
		die "the ask is still up after 10 tries (tmux's ? mark hides the kind: a plan or question overlay eats y|n - 'cap' shows which; send Escape, twice if the first only opened the plan's editor)"
	}
}

cmd_cap() {
	e="" out=""
	while [ $# -gt 0 ]; do
		case "$1" in
			-e) e=1 ;;
			-*) die "cap: -e or a file" ;;
			*) out=$1 ;;
		esac
		shift
	done
	load
	case $BACKEND in
		rex)
			fmt=text
			[ -n "$e" ] && fmt=vt
			if [ -n "$out" ]; then
				rex capture -s "$RSESSION" -b "$RBLK" --format="$fmt" >"$out" || die "capture failed"
				say "$out"
			else
				exec rex capture -s "$RSESSION" -b "$RBLK" --format="$fmt"
			fi
			;;
		*)
			[ -n "$e" ] && e=-e || e=""
			if [ -n "$out" ]; then
				tmux -L "$SERVER" capture-pane -t "$SESSION" -p $e >"$out" || die "capture failed"
				say "$out"
			else
				exec tmux -L "$SERVER" capture-pane -t "$SESSION" -p $e
			fi
			;;
	esac
}

# cmd_snap: capture, mask, save - one side of a row-shift diff.
cmd_snap() {
	load
	out=${1:-$TREE/snap/prev.txt}
	case "$out" in /*) ;; *) out=$TREE/snap/$out ;; esac
	mkdir -p "$(dirname "$out")"
	cap >"${out%.txt}.raw"
	[ -s "${out%.txt}.raw" ] || die "capture failed (the pane is gone?)"
	mask_volatile <"${out%.txt}.raw" >"$out" || die "python3 is needed"
	say "$out (raw beside it)"
}

# cmd_diff: two masked captures diffed - the row-shift house rule as a
# check, exit 1 when rows moved. No file diffs a fresh capture against the
# last snap; one file diffs against FILE; two diffs those two.
cmd_diff() {
	load
	case $# in
		0) A=$TREE/snap/prev.txt B="" ;;
		1) A=$1 B="" ;;
		2) A=$1 B=$2 ;;
		*) die "diff: [FILE-A] [FILE-B]" ;;
	esac
	case "$A" in /*) ;; *) A=$TREE/snap/$A ;; esac
	[ -f "$A" ] || die "no snapshot at $A (zemi-lab snap first)"
	mkdir -p "$TREE/snap"
	if [ -n "$B" ]; then
		case "$B" in /*) ;; *) B=$TREE/snap/$B ;; esac
		[ -f "$B" ] || die "no capture at $B"
	else
		B=$TREE/snap/now.txt
		cap >"$TREE/snap/now.raw"
		[ -s "$TREE/snap/now.raw" ] || die "capture failed (the pane is gone?)"
		mask_volatile <"$TREE/snap/now.raw" >"$B" || die "python3 is needed"
	fi
	if diff -u --label A --label B "$A" "$B"; then
		say "no row shift"
	else
		exit 1
	fi
}

# check_size SESSION BLOCK W H: Rex applies a resize at once only when no
# client owns the block, and the call exits 0 either way - read the size
# back so a silently ignored resize (a false-positive layout test) dies.
check_size() {
	got=$(rex block call -s "$1" -b "$2" size 2>/dev/null |
		python3 -c 'import json,sys;d=json.load(sys.stdin);print(d.get("columns"), d.get("rows"))')
	[ "$got" = "$3 $4" ] ||
		die "resize to $3 x $4 did not stick (the terminal reports ${got:-?}; a client owning the block keeps its size - bake layouts into up -x W -y H)"
}

cmd_size() {
	[ $# -eq 2 ] || die "size: W H"
	load
	case $BACKEND in
		rex)
			rex block call -s "$RSESSION" -b "$RBLK" resize "{\"columns\":$1,\"rows\":$2}" >/dev/null ||
				die "resize failed"
			check_size "$RSESSION" "$RBLK" "$1" "$2"
			;;
		*) tmux -L "$SERVER" resize-window -t "$SESSION" -x "$1" -y "$2" ;;
	esac
}

# cmd_peer: a second zemi on the same tree, so two windows share the store,
# the config and the fake model exactly as two real windows on one project
# do. `-s peer` points the drive commands at it.
cmd_peer() {
	W=140 H=40 WIN=peer
	while [ $# -gt 0 ]; do
		case "$1" in
			-x | -y)
				[ $# -ge 2 ] || die "peer: $1 needs a value"
				if [ "$1" = -x ]; then W=$2; else H=$2; fi
				shift 2
				;;
			-*) die "peer: unknown flag $1" ;;
			*) WIN=$1; shift ;;
		esac
	done
	load
	BIN=${ZEMI_BIN:-$REPO/bin/zemi}
	case $BIN in /*) ;; *) BIN=$(cd "$(dirname "$BIN")" && pwd)/$(basename "$BIN") ;; esac
	[ -x "$BIN" ] || die "no zemi binary at $BIN"
	# the peer gets its own fake model writing under req-$WIN: two windows
	# share the store, never the request stream, so words typed in one window
	# cannot certify a prompt another window never delivered
	PFAKE=$TREE/req-$WIN
	PPORT=$(free_port) || die "python3 is needed"
	rm -rf "$PFAKE" "$TREE/config-$WIN"
	mkdir -p "$PFAKE" "$TREE/config-$WIN"
	write_config "$TREE/config-$WIN" "$PPORT"
	if [ "$BACKEND" = rex ]; then
		[ -n "$(block_id "$WIN")" ] && die "window '$WIN' is already up (zemi-lab down reboots all)"
		FB2=$(rex run -s "$RSESSION" --label "fake-$WIN" --keep-open --focus=false --json -- \
			python3 "$DIR/fake_openai.py" "$PPORT" "$PFAKE" |
			python3 -c 'import json,sys;print(json.load(sys.stdin)["block_ids"][0])') ||
			die "the $WIN fake model block failed to start"
		wait_port "$PPORT" || {
			rex capture -s "$RSESSION" -b "$FB2" 2>/dev/null | grep -v '^ *$' | tail -5 >&2
			die "the $WIN fake model died (port taken?)"
		}
		RB=$(rex run -s "$RSESSION" -c "$TREE/proj" --label "$WIN" --keep-open --focus=false --json -- \
			env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor ZEMI_BIN="$BIN" ZEMI_LAB_CONFIG="$TREE/config-$WIN" "$DIR/zemi-safe" "$TREE" ${LAB_TRUST:+"$LAB_TRUST"} |
			python3 -c 'import json,sys;print(json.load(sys.stdin)["block_ids"][0])') ||
			die "the $WIN block failed to start"
		rex block call -s "$RSESSION" -b "$RB" resize "{\"columns\":$W,\"rows\":$H}" >/dev/null ||
			die "resize to $W x $H failed"
		check_size "$RSESSION" "$RB" "$W" "$H"
		{
			printf '%s %s\n' "$WIN" "$RB"
			printf 'fake-%s %s\n' "$WIN" "$FB2"
		} >>"$BLOCKS"
		RBLK=$RB
	else
		tmux -L "$SERVER" has-session -t "$WIN" 2>/dev/null && die "window '$WIN' is already up (zemi-lab down reboots all)"
		tmux -L "$SERVER" new-session -d -s "fake-$WIN" -c "$PFAKE" \
			"python3 '$DIR/fake_openai.py' $PPORT '$PFAKE'" || die "the $WIN fake model failed to start"
		wait_port "$PPORT" || {
			tmux -L "$SERVER" capture-pane -t "fake-$WIN" -p 2>/dev/null | grep -v '^ *$' | tail -5 >&2
			die "the $WIN fake model died (port taken?)"
		}
		tmux -L "$SERVER" new-session -d -s "$WIN" -x "$W" -y "$H" -c "$TREE/proj" \
			"exec env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor ZEMI_BIN='$BIN' ZEMI_LAB_CONFIG='$TREE/config-$WIN' '$DIR/zemi-safe' '$TREE'${LAB_TRUST:+ $LAB_TRUST}" ||
			die "tmux new-session failed"
	fi
	i=0
	while [ "$i" -lt 120 ]; do
		case $BACKEND in
			rex) cur=$(rex capture -s "$RSESSION" -b "$RBLK" 2>/dev/null || true) ;;
			*) cur=$(tmux -L "$SERVER" capture-pane -t "$WIN" -p 2>/dev/null || true) ;;
		esac
		case "$cur" in *"Ask anything"*) break ;; esac
		i=$((i + 1))
		sleep 0.25
	done
	[ "$i" -lt 120 ] || die "window '$WIN' did not boot in 30s"
	say "window $WIN up on the same store, its own fake model on 127.0.0.1:$PPORT: drive it with zemi-lab -s $WIN prompt|cap|wait"
}

cmd_last() {
	req=$(req_base)
	[ -f "$req/last_request.json" ] || die "no request yet (last_request.json is missing)"
	if [ -f "$TREE/.lab.turn-$SESSION" ]; then
		at_prompt=$(cat "$TREE/.lab.turn-$SESSION")
		now_count=$(find "$req/requests" -type f 2>/dev/null | wc -l)
		[ "$now_count" -gt "$at_prompt" ] ||
			die "no request arrived after the last prompt (the turn died before the model? check zemi-lab logs)"
	fi
	cat "$req/last_request.json"
}

cmd_db() {
	# shellcheck disable=SC2012  # newest db first, on the lab's own tree
	db=$(ls -t "$TREE"/state/projects/*/zemi.db 2>/dev/null | head -1) || true
	# shellcheck disable=SC2015  # found or die
	[ -n "$db" ] && say "$db" || die "no zemi.db yet"
}

cmd_logs() {
	# shellcheck disable=SC2012  # newest log first, on the lab's own tree
	log=$(ls -t "$TREE"/state/logs/* 2>/dev/null | head -1) || true
	# shellcheck disable=SC2015  # found or die
	[ -n "$log" ] && say "$log" || die "no log yet"
}

cmd_status() {
	load
	say "lab $NAME: $TREE"
	say "  fake model 127.0.0.1:${LAB_PORT:-?}"
	case $BACKEND in
		rex)
			say "  rex session $RSESSION"
			rex block ls -s "$RSESSION" --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
try:
    for b in (d["blocks"] if isinstance(d, dict) else d):
        print("   ", b.get("label", "?"), b["block_id"])
    sys.stdout.flush()
except BrokenPipeError:
    import os
    os._exit(0)
' || say "  rex session down"
			;;
		*)
			say "  tmux server $SERVER"
			tmux -L "$SERVER" list-sessions 2>/dev/null || say "  tmux server down"
			;;
	esac
}

# cmd_title: the pane title - `? ` while an ask is up, plain otherwise
# (rex lab: whatever the last title_changed carried).
cmd_title() {
	load
	case $BACKEND in
		rex)
			rex block call -s "$RSESSION" -b "$RBLK" title 2>/dev/null |
				python3 -c 'import json,sys;print(json.load(sys.stdin).get("title",""))' || die "title failed"
			;;
		*) tmux -L "$SERVER" display -p -t "$SESSION" '#{pane_title}' ;;
	esac
}

cmd_records() {
	load
	[ "$BACKEND" = rex ] || die "records: a rex lab only (tmux swallows OSC 7501)"
	rex block call -s "$RSESSION" -b "$RBLK" program_status 2>/dev/null || die "records failed"
}

# cmd_events: what the terminal saw, one line per event - the assertion
# surface for the sequences tmux swallows. NAME filters by event name; no
# match exits 1, so a test can `zemi-lab events desktop_notification`.
cmd_events() {
	# no load: a downed session (down --keep) is exactly the state events must
	# still serve - its kept tree holds the final stream, the only read left
	# that can assert the exit clear
	case "$SESSION" in
		fake | recorder) die "'$SESSION' is lab plumbing, not a window (-s main|peer)" ;;
	esac
	[ -f "$ENVF" ] || die "no lab '$NAME' at $TREE (zemi-lab up first)"
	# shellcheck disable=SC1090
	. "$ENVF"
	BACKEND=${LAB_BACKEND:-tmux}
	RSESSION=${LAB_RSESSION:-}
	RBLK=$(block_id "$SESSION")
	[ "$BACKEND" = rex ] || die "events: a rex lab only (tmux swallows those sequences)"
	[ -f "$TREE/events.jsonl" ] || die "no events stream at $TREE/events.jsonl"
	# a live session's stream must still be written: a dead recorder freezes it
	# and a frozen stream passes every grep, so ask the kernel who holds
	# events.jsonl open, not whether the recorder's block still answers
	if rex block ls -s "$RSESSION" --json >/dev/null 2>&1; then
		lsof -t "$TREE/events.jsonl" >/dev/null 2>&1 ||
			die "nothing is writing $TREE/events.jsonl; the stream is stale (zemi-lab up again)"
	else
		# a kept stream can be short: a recorder killed mid-lab froze the file
		# while zemi kept writing, so an absence assertion on it can pass on a
		# stream that stopped early. down marks a tree whose recorder was
		# already dead at teardown - refuse on the mark, warn when the tree
		# outlived the stream some other way
		[ -f "$TREE/.lab.stale-stream" ] &&
			die "the stream was already stale when the lab was kept (the recorder died early) - absence assertions on it false-pass; read $TREE/events.jsonl directly"
		late=$(python3 - "$TREE" <<'STALE'
import os, sys

tree = sys.argv[1]
stream = os.path.getmtime(os.path.join(tree, "events.jsonl"))
late = ""
for root, dirs, files in os.walk(tree):
    dirs[:] = [d for d in dirs if d != "snap"]
    for f in files:
        if f.startswith("events") or f.startswith(".lab"):
            continue
        p = os.path.join(root, f)
        if os.path.getmtime(p) - stream > 2:
            late = p
            break
    if late:
        break
print(late)
STALE
		)
		[ -n "$late" ] &&
			printf 'zemi-lab: warning: %s was written after the stream ended; the recorder died early and absence assertions on this kept stream can false-pass\n' "$late" >&2
	fi
	BLOCK_LIST=$(awk '$1 != "fake" && $1 !~ /^fake-/ && $1 != "recorder" {print $2}' "$BLOCKS" 2>/dev/null)
	BLOCKS="$RBLK $BLOCK_LIST" ZEMI_LAB_EVENTS="$TREE/events.jsonl" python3 - "$@" <<'PYEOF'
import json, os, sys

ids = {x for x in os.environ.get("BLOCKS", "").split() if x}
names = set(sys.argv[1:])


def brief(n, p):
    if n == "process_changed":
        f = p.get("foreground")
        if not f:
            return "fg=none"
        return "fg=%s pid=%s" % (f.get("name", "?"), f.get("pid", "?"))
    if n == "program_status_changed":
        r = p.get("record", {})
        s = "state=" + r.get("state", "")
        if r.get("kind"):
            s += " kind=" + r["kind"]
        if r.get("msg"):
            s += " msg=" + r["msg"]
        return s
    if n == "program_status_removed":
        return "reason=" + p.get("reason", "")
    if n == "desktop_notification":
        return (p.get("title", "") + " | " + p.get("body", "")).strip(" |")
    if n == "title_changed":
        return repr(p.get("title", ""))
    if n == "child_exited":
        return "exit=" + str(p.get("exit_code"))
    if n == "size_changed":
        return "%sx%s" % (p.get("columns"), p.get("rows"))
    return json.dumps(p)[:120]


hits = 0
try:
    for line in open(os.environ["ZEMI_LAB_EVENTS"]):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        ev = d.get("payload", {}).get("event", {})
        if ev.get("type") != "block_event":
            continue
        p = ev.get("payload", {})
        if p.get("block_id") not in ids:
            continue
        n = p.get("name", "")
        if names and n not in names:
            continue
        hits += 1
        print(n + "\t" + brief(n, p.get("payload", {})))
    sys.stdout.flush()
except BrokenPipeError:
    import os
    os._exit(0)
if hits == 0:
    print("no matching events")
    sys.exit(1)
PYEOF
}

cmd_health() {
	# a peer's health reads its own config (its fake's port), not main's
	if [ "$SESSION" = main ]; then
		"$DIR/zemi-safe" "$TREE" -C "$TREE/proj" health "$@"
	else
		ZEMI_LAB_CONFIG="$TREE/config-$SESSION" "$DIR/zemi-safe" "$TREE" -C "$TREE/proj" health "$@"
	fi
}

cmd_attach() {
	load
	case $BACKEND in
		rex) say "the lab runs in Rex session $RSESSION; open it in the Rex app or: rex focus -s '$RSESSION'" ;;
		*) exec tmux -L "$SERVER" attach -t "$SESSION" ;;
	esac
}

cmd_down() {
	keep="" force=""
	for a do
		case "$a" in
			--keep) keep=1 ;;
			--force) force=1 ;;
			*) die "down: --keep or --force" ;;
		esac
	done
	if [ -f "$ENVF" ]; then
		# shellcheck disable=SC1090
		. "$ENVF"
		if [ "${LAB_BACKEND:-tmux}" = rex ] && [ -n "${LAB_RSESSION:-}" ]; then
			live=""
			if [ -f "$BLOCKS" ]; then
				fgp=$(fgpid "$LAB_RSESSION" "$(awk '$1 == "main" {print $2}' "$BLOCKS")")
				{ [ -n "$fgp" ] && kill -0 "$fgp" 2>/dev/null; } && live=1
			fi
			# a dead zemi turns the quit dance into a 4s wait that silently
			# lands no exit clear: refuse - unless the tree was kept (the
			# documented cleanup is a plain down) or --force reaps without it
			[ -n "$live" ] || [ -n "$force" ] || [ -f "$TREE/.lab.kept" ] ||
				die "zemi's main window is dead (${fgp:-no live process}); down --force reaps the lab, a live peer included"
			# a recorder that died before the quit leaves a stream that ends
			# early: mark it, so kept-tree events refuses absence assertions.
			# A teardown of an already-kept tree must not re-mark: its stream
			# is complete by then and the recorder is supposed to be gone.
			{ [ -n "$live" ] || [ -n "$force" ]; } && [ ! -f "$TREE/.lab.kept" ] && {
				lsof -t "$TREE/events.jsonl" >/dev/null 2>&1 ||
					touch "$TREE/.lab.stale-stream"
			}
			# quit zemi first so the exit clear reaches the terminal. Keys go to
			# the zemi blocks only: a ctrl+c to the recorder's block would kill
			# the stream mid-write. An ask or overlay is dismissed first, and a
			# mid-turn zemi eats the first ctrl+c as an interrupt (a drafted one
			# as a draft-clear), so send until the terminal reports the status
			# removed - bounded, then a plain kill takes whatever is left
			# (rex kill would otherwise strand the last record). A corpse skips
			# the dance: its keys land nowhere and the 4s wait buys nothing.
			if [ -n "$live" ] && [ -f "$BLOCKS" ]; then
				zblocks=$(awk '$1 != "fake" && $1 !~ /^fake-/ && $1 != "recorder" {print $2}' "$BLOCKS")
				for bid in $zblocks; do
					rex send-key -s "$LAB_RSESSION" -b "$bid" -- escape 2>/dev/null || true
				done
				i=0
				while [ "$i" -lt 8 ]; do
					for bid in $zblocks; do
						rex send-key -s "$LAB_RSESSION" -b "$bid" -- ctrl+c 2>/dev/null || true
					done
					grep -q program_status_removed "$TREE/events.jsonl" 2>/dev/null && break
					sleep 0.5
					i=$((i + 1))
				done
			fi
			rex kill "$LAB_RSESSION" 2>/dev/null || true
		elif [ "${LAB_BACKEND:-tmux}" != rex ]; then
			# the rex branch refuses a corpse above; tmux's pane gone is the
			# same situation and gets the same refusal (a kept tree's plain
			# down, the documented cleanup, skips it)
			tmux -L "$SERVER" has-session -t "$SESSION" 2>/dev/null ||
				[ -n "$force" ] || [ -f "$TREE/.lab.kept" ] ||
				die "zemi's main window is dead (the pane is gone); down --force reaps the lab"
		fi
	else
		# a mistyped -n must not read as a successful teardown
		say "no lab named $NAME is up (nothing to tear down)"
	fi
	# the label, not the env file, is what down trusts: a tree moved
	# (ZEMI_LAB_TREE) or deleted, a backend switch - whatever diverged, every
	# session named for this lab dies here
	# shellcheck disable=SC2046
	rex kill $(rex_sessions_by_label) 2>/dev/null || true
	# a rex lab never had a tmux server; probing its socket would create the
	# dead socket file this teardown is supposed to leave nothing of
	[ "${LAB_BACKEND:-tmux}" = rex ] || tmux -L "$SERVER" kill-server 2>/dev/null || true
	# kill-server itself probes the server: a dead one leaves (or gains) its
	# zero-byte socket file, and a live one keeps its socket
	[ "${LAB_BACKEND:-tmux}" = rex ] ||
		{ tmux -L "$SERVER" has-session 2>/dev/null || rm -f "${TMPDIR:-/tmp}"/tmux-*/"$SERVER"; }
	# the kept mark tells a later plain down this tree is a kept one, so the
	# documented cleanup (a plain down re-tears it) skips the corpse refusal
	if [ -n "$keep" ]; then
		[ -d "$TREE" ] && touch "$TREE/.lab.kept"
	else
		rm -f "$TREE/.lab.kept"
	fi
	if [ -z "$keep" ]; then
		case "$TREE" in
			${TMPDIR:-/tmp}/* | /tmp/* | /private/tmp/*) rm -rf "$TREE" ;;
			*) say "kept $TREE (outside the scratch dirs; delete by hand)" ;;
		esac
	fi
}

case "$CMD" in
	up) cmd_up "$@" ;;
	peer) cmd_peer "$@" ;;
	prompt) load; cmd_prompt "$@" ;;
	type) load; cmd_type "$@" ;;
	send) load; cmd_send "$@" ;;
	wait) load; cmd_wait "$@" ;;
	ask) load; cmd_ask "$@" ;;
	cap) cmd_cap "$@" ;;
	size) cmd_size "$@" ;;
	snap) cmd_snap "$@" ;;
	diff) cmd_diff "$@" ;;
	events) cmd_events "$@" ;;
	records) cmd_records "$@" ;;
	title) cmd_title "$@" ;;
	last) load; cmd_last "$@" ;;
	db) load; cmd_db "$@" ;;
	logs) load; cmd_logs "$@" ;;
	status) load; cmd_status "$@" ;;
	health) load; cmd_health "$@" ;;
	attach) load; cmd_attach "$@" ;;
	down) cmd_down "$@" ;;
	*) usage ;;
esac
